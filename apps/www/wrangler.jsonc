{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workly",
  "compatibility_date": "2026-10-01",
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "none"
  },
  "vars": {
    // Leer lassen, solange keine Turnstile-Schlüssel hinterlegt sind; dann entfällt die Prüfung.
    "TURNSTILE_SITE_KEY": ""
  },
  // Warteliste. Ohne database_id verbindet `wrangler deploy` die Datenbank über ihren Namen
  // oder legt sie beim ersten Deploy an. Für Speicherung in der EU vorher anlegen:
  //   pnpm --filter @workly/www exec wrangler d1 create workly-warteliste --jurisdiction eu
  "d1_databases": [
    {
      "binding": "WARTELISTE",
      "database_name": "workly-warteliste",
      "migrations_dir": "migrations"
    }
  ]
}
