{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workly-www",
  "compatibility_date": "2026-10-01",
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "none"
  },
  "vars": {
    // Leer lassen, solange keine Turnstile-Schlüssel hinterlegt sind; dann entfällt die Prüfung.
    "TURNSTILE_SITE_KEY": ""
  },
  // Warteliste: D1 in der EU-Jurisdiktion anlegen mit
  //   wrangler d1 create workly-warteliste --jurisdiction eu
  // und die ausgegebene database_id hier eintragen.
  "d1_databases": [
    {
      "binding": "WARTELISTE",
      "database_name": "workly-warteliste",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
